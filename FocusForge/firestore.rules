rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FocusForge stores each user's workspace in users/{uid}/focusforge/workspace.
    // A signed-in user can read and write only their own workspace document.
    match /users/{userId}/focusforge/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
